{
  "name": "educational-skills-ru-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the bilingual RU/EN Educational Skills library as callable tools",
  "license": "CC-BY-SA-4.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "educational-skills-ru": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/skills.json"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "cp src/skills.json dist/skills.json",
    "bundle-skills": "tsx scripts/bundle-skills.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke:local-http": "tsx scripts/smoke-local-http.ts",
    "test": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
